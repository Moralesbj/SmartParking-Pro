# Copy to .env (never commit .env). Generate every secret; do not reuse these placeholders.
# PowerShell:  [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
# Bash:        openssl rand -base64 32

DB_USER=smartparking
DB_PASSWORD=
# AES-256 key (base64, 32 bytes) for MFA seeds and device credentials.
APP_ENCRYPTION_KEY=
# Two-step verification (TOTP). false = login with e-mail and password only (default).
MFA_ENABLED=false
# Shared token between backend and ai-service.
ALPR_SERVICE_TOKEN=

# Local HTTP without TLS needs COOKIE_SECURE=false. Always true behind HTTPS.
COOKIE_SECURE=false
HTTP_PORT=8088
APP_PUBLIC_URL=http://localhost:8088

# One-time first administrator, only used when the users table is empty.
# Password: 8–72 characters, generated per environment, never reused in production. Remove after first start.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=

# ALPR: SIMULATOR (in-process echo) or HTTP (ai-service OpenCV pipeline over synthetic frames).
ALPR_MODE=HTTP
ALPR_PROVIDER=TEMPLATE_OCR

# E-mail: DISABLED (default) or LOG (developer machine only; writes reset links to the backend log).
MAIL_MODE=DISABLED
